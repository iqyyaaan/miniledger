# Copy to .env — `cp .env.example .env` — and you are ready to run.
# These defaults match the Postgres in docker-compose.yml.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://miniledger:miniledger@localhost:5432/miniledger
DATABASE_SSL=false

# Must be at least 32 characters. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-before-deploying-anywhere-32chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Returns the OTP in the API response so the app can prefill it during a demo.
# The server refuses to boot with this set to true when NODE_ENV=production.
OTP_ECHO_IN_RESPONSE=true

# "Overdue" is a calendar comparison, so it needs a timezone.
APP_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY_CODE=+91

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

CORS_ORIGIN=*
LOG_LEVEL=info
